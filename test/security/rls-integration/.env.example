# Kopiera till .env i samma katalog INNAN uppstart på NUC.
# Detta är ett engångslösenord för en helt lokal, isolerad
# testcontainer — inte relaterat till Production, inte till Djupvik.
# Committa aldrig den riktiga .env-filen.

# Valfritt starkt lösenord, t.ex: openssl rand -base64 24
TEST_PG_PASSWORD=

# Värdport denna testmiljö exponeras på. Default 55432 valt för att
# INTE krocka med Supabases vanliga lokala port 54322 eller Postgres
# standardport 5432 — verifiera ändå manuellt att porten är ledig på
# NUC innan uppstart (se README.md, steg "Pre-flight-kontroller").
TEST_PG_PORT=55432
